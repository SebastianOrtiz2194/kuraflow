# Copy this file to .env and fill in real values for local development
# cp .env.example .env

DB_URL=jdbc:postgresql://localhost:5432/KuraFlow
DB_USERNAME=KuraFlow
DB_PASSWORD=your_db_password
MAIL_PASSWORD=your_mail_password
# Required. Shared HMAC key for signing and verifying JWTs: every service must use the same value.
# At least 32 bytes, or the services refuse to start. Generate one with: openssl rand -base64 48
JWT_SECRET=
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@kuraflow.com
